# ─────────────────────────────────────────────────────────────────────────────
# Onkimia Platform — Variables de entorno
# Copia este archivo a .env.local (desarrollo) o configúralo en el servidor.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Obtener en: https://sanity.io → proyecto → Settings → API

# ID del proyecto Sanity (visible en sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset activo (normalmente "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Versión de la API Sanity (no cambiar salvo actualización intencional)
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Token de lectura para ISR/fetch en servidor (Sanity → Settings → API → Tokens → Add)
# Permisos mínimos: "Viewer"
SANITY_API_READ_TOKEN=

# ── Odoo CRM ──────────────────────────────────────────────────────────────────
# Los leads del formulario de contacto se crean directamente en Odoo.
# Obtener en: Odoo → Settings → Technical → API Keys

# URL base del servidor Odoo (sin trailing slash)
# Ejemplo: https://crm.onkimia.com
ODOO_URL=

# Nombre de la base de datos Odoo
ODOO_DATABASE=

# Usuario de API (email del usuario en Odoo)
ODOO_USERNAME=

# API Key del usuario (Odoo 18: Settings → My Profile → API Keys → New)
ODOO_API_KEY=

# ── SMTP (correo de bolsa de trabajo / candidatos) ────────────────────────────
# El formulario de CONTACTO va directo a Odoo — NO usa email.
# El formulario de CANDIDATOS (bolsa de trabajo) envía el CV por este SMTP.
# Configura el servidor SMTP que IT provea (no se usa Resend ni servicio externo).

# Host del servidor SMTP
# Ejemplo: mail.onkimia.com  o  smtp.tuproveedor.com
SMTP_HOST=

# Puerto SMTP (25 / 465 / 587 — consultar con IT)
SMTP_PORT=587

# Usar TLS/SSL desde el inicio de la conexión (true = puerto 465; false = STARTTLS en 587)
SMTP_SECURE=false

# Usuario SMTP (generalmente el email remitente)
SMTP_USER=

# Contraseña de la cuenta SMTP
SMTP_PASSWORD=

# Dirección "From" que verá el destinatario
# Ejemplo: "Onkimia Bolsa de Trabajo <noreply@onkimia.com>"
SMTP_FROM=

# ── Correo de destino — Bolsa de trabajo ──────────────────────────────────────
# Las aplicaciones de candidatos se envían a esta dirección
JOB_BOARD_EMAIL=eortega@onkimia.com

# ── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────────
# Obtener en: https://dash.cloudflare.com → Turnstile → Add site

# Clave pública (expuesta al cliente, segura)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clave secreta (solo servidor, NUNCA al cliente)
TURNSTILE_SECRET_KEY=

# ── SEO / URLs ────────────────────────────────────────────────────────────────
# URL pública del sitio, sin trailing slash
# Ejemplo: https://www.onkimia.com
NEXT_PUBLIC_SITE_URL=https://www.onkimia.com
